Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    # تمرير ترويسة Authorization إلى PHP (تلزم في مرحلة الحسابات).
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    # أي مسار لا يطابق ملفاً موجوداً (مثل ping.php) يذهب إلى index.php.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [QSA,L]
</IfModule>
